<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>الفلاتر — كار تراك</title>
  <link rel="stylesheet" href="css/main.css">
  <style>
    /* ===== بطاقة الفلاتر ===== */
    .filters-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      margin-bottom: 14px;
    }

    .filters-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
    }

    .filter-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .filter-field label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text2);
    }

    .filter-field select,
    .filter-field input {
      width: 100%;
      background: var(--bg3);
      border: 1px solid var(--border2);
      border-radius: var(--radius2);
      padding: 8px 12px;
      font-family: "Cairo", sans-serif;
      font-size: 13px;
      color: var(--text);
      outline: none;
      color-scheme: dark;
    }

    .filter-field select:focus,
    .filter-field input:focus {
      border-color: var(--accent);
    }

    /* ===== فترات سريعة ===== */
    .quick-ranges {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }

    .quick-ranges .qr-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text3);
      margin-inline-end: 2px;
    }

    .quick-ranges .btn {
      padding: 5px 12px;
      font-size: 11px;
    }

    .quick-ranges .btn.active {
      background: rgba(79, 124, 255, 0.16);
      border-color: var(--accent);
      color: var(--accent);
      font-weight: 700;
    }

    /* ===== ملخص النتائج ===== */
    .filter-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: var(--radius2);
      padding: 10px 14px;
      margin-bottom: 16px;
      font-size: 12px;
      color: var(--text2);
    }

    .filter-summary strong {
      color: var(--text);
    }

    .filter-summary .fs-cost {
      color: var(--green);
      font-weight: 700;
    }

    @media (max-width: 560px) {
      .filters-card {
        padding: 12px;
      }

      .filters-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .filter-field.car-field,
      .filter-field.type-field {
        grid-column: 1 / -1;
      }

      .quick-ranges .btn {
        flex: 1 1 auto;
        justify-content: center;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <div id="sidebar-mount"></div>
    <div class="main">
      <div class="sm-menu">
        <div class="sidebar-logo">
          <div class="logo-icon">🚗</div>
          <div class="text">
            <h1>كار تراكر</h1>
            <p>نظام متابعة السيارات</p>
          </div>
        </div>
        <div class="bars">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="topbar">
        <div>
          <div class="page-title">🔧 الفلاتر</div>
          <div class="page-sub">فلتر الهواء والبنزين والزيت وكابينة</div>
        </div>
        <button class="btn btn-primary" onclick="openModal()">+ تسجيل تغيير فلتر</button>
      </div>
      <div class="content">
        <div class="filters-card">
          <div class="filters-grid">
            <div class="filter-field car-field">
              <label for="filter-car">السيارة</label>
              <select id="filter-car" onchange="loadFilters()">
                <option value="">🚗 كل السيارات</option>
              </select>
            </div>
            <div class="filter-field type-field">
              <label for="filter-type">نوع الفلتر</label>
              <select id="filter-type" onchange="loadFilters()">
                <option value="">كل الأنواع</option>
                <option value="air">فلتر هواء</option>
                <option value="oil">فلتر زيت</option>
                <option value="fuel">فلتر بنزين</option>
                <option value="cabin">فلتر كابينة</option>
                <option value="other">أخرى</option>
              </select>
            </div>
            <div class="filter-field">
              <label for="filter-from">من تاريخ</label>
              <input type="date" id="filter-from" onchange="onDateManualChange()">
            </div>
            <div class="filter-field">
              <label for="filter-to">إلى تاريخ</label>
              <input type="date" id="filter-to" onchange="onDateManualChange()">
            </div>
          </div>

          <div class="quick-ranges">
            <span class="qr-label">فترات سريعة:</span>
            <button type="button" class="btn btn-ghost" data-range="today" onclick="setQuickRange('today')">اليوم</button>
            <button type="button" class="btn btn-ghost" data-range="week" onclick="setQuickRange('week')">آخر أسبوع</button>
            <button type="button" class="btn btn-ghost" data-range="month" onclick="setQuickRange('month')">هذا الشهر</button>
            <button type="button" class="btn btn-ghost" data-range="last30" onclick="setQuickRange('last30')">آخر ٣٠ يوم</button>
            <button type="button" class="btn btn-ghost" data-range="all" onclick="setQuickRange('all')">كل الفترات</button>
          </div>
        </div>

        <div class="filter-summary" id="filter-summary"></div>

        <div class="maint-grid" id="filter-list">
          <div class="loading">جاري التحميل...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay hidden" id="modal">
    <div class="modal">
      <div class="modal-head">
        <h2>🔧 تسجيل تغيير فلتر</h2><button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-row"><label>السيارة *</label><select id="f-car">
            <option value="">اختر السيارة</option>
          </select></div>
        <div class="form-grid">
          <div class="form-row"><label>نوع الفلتر</label>
            <select id="f-type">
              <option value="air">فلتر هواء</option>
              <option value="oil">فلتر زيت</option>
              <option value="fuel">فلتر بنزين</option>
              <option value="cabin">فلتر كابينة</option>
              <option value="other">أخرى</option>
            </select>
          </div>
          <div class="form-row"><label>تاريخ التغيير *</label><input id="f-date" type="date"></div>
        </div>
        <div class="form-grid">
          <div class="form-row"><label>الكيلومتراج *</label><input id="f-km" type="number" placeholder="65000"></div>
          <div class="form-row"><label>التغيير القادم</label>
            <select id="f-next">
              <option value="10000">كل 10,000 كم</option>
              <option value="15000">كل 15,000 كم</option>
              <option value="20000" selected>كل 20,000 كم</option>
              <option value="30000">كل 30,000 كم</option>
              <option value="40000">كل 40,000 كم</option>
            </select>
          </div>
        </div>
        <div class="form-grid">
          <div class="form-row"><label>الماركة</label><input id="f-brand" placeholder="بوش / مان / فيلتروم"></div>
          <div class="form-row"><label>التكلفة (جنيه)</label><input id="f-cost" type="number" placeholder="150"></div>
        </div>
        <div class="form-row"><label>الورشة</label><input id="f-workshop" placeholder="اسم الورشة"></div>
        <div class="form-row"><label>ملاحظات</label><input id="f-notes" placeholder="أي تفاصيل"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" onclick="closeModal()">إلغاء</button>
        <button class="btn btn-primary" onclick="saveFilter()">💾 حفظ</button>
      </div>
    </div>
  </div>


  <script src="js/jquery.min.js"></script>
  <script src="js/sidebar.js"></script>
  <script src="js/utils.js"></script>
  <script>
    renderSidebar();

    const TYPE_LABELS = { air: 'فلتر هواء', oil: 'فلتر زيت', fuel: 'فلتر بنزين', cabin: 'فلتر كابينة', other: 'أخرى' };

    // تاريخ محلي بصيغة YYYY-MM-DD (بدون مشاكل التوقيت)
    function isoLocal(d = new Date()) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    }

    function periodText(from, to) {
      if (from && to) {
        if (from === to) return `تقرير يوم ${fmtDate(from)}`;
        return `من ${fmtDate(from)} إلى ${fmtDate(to)}`;
      }
      if (from) return `من ${fmtDate(from)} حتى الآن`;
      if (to) return `حتى ${fmtDate(to)}`;
      return 'كل الفترات';
    }

    function markQuickRange(range) {
      document.querySelectorAll('.quick-ranges .btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.range === range);
      });
    }

    function setQuickRange(type) {
      const now = new Date();
      const fromEl = document.getElementById('filter-from');
      const toEl = document.getElementById('filter-to');

      if (type === 'today') {
        fromEl.value = isoLocal(now);
        toEl.value = isoLocal(now);
      } else if (type === 'week') {
        const start = new Date(now);
        start.setDate(start.getDate() - 6);
        fromEl.value = isoLocal(start);
        toEl.value = isoLocal(now);
      } else if (type === 'month') {
        fromEl.value = isoLocal(new Date(now.getFullYear(), now.getMonth(), 1));
        toEl.value = isoLocal(new Date(now.getFullYear(), now.getMonth() + 1, 0));
      } else if (type === 'last30') {
        const start = new Date(now);
        start.setDate(start.getDate() - 29);
        fromEl.value = isoLocal(start);
        toEl.value = isoLocal(now);
      } else {
        fromEl.value = '';
        toEl.value = '';
      }

      markQuickRange(type);
      loadFilters();
    }

    // المستخدم اختار تواريخ يدويًا
    function onDateManualChange() {
      markQuickRange('');
      loadFilters();
    }

    async function init() {
      const { data: cars } = await get('/cars');
      const opts = cars.map(c => `<option value="${c.id}">${c.plate} — ${c.make} ${c.model}</option>`).join('');
      document.getElementById('f-car').innerHTML = '<option value="">اختر السيارة</option>' + opts;
      document.getElementById('filter-car').innerHTML = '<option value="">🚗 كل السيارات</option>' + opts;
      markQuickRange('all');
      loadFilters();
    }

    async function loadFilters() {
      const carId = document.getElementById('filter-car').value;
      const type = document.getElementById('filter-type').value;
      const from = document.getElementById('filter-from').value;
      const to = document.getElementById('filter-to').value;

      if (from && to && from > to) {
        document.getElementById('filter-summary').innerHTML =
          `<span style="color:var(--red);font-weight:700">⚠️ تاريخ البداية لازم يكون قبل تاريخ النهاية</span>`;
        toast('تاريخ البداية لازم يكون قبل تاريخ النهاية', 'error');
        return;
      }

      const qs = new URLSearchParams();
      if (carId) qs.set('car_id', carId);
      if (type) qs.set('filter_type', type);
      if (from) qs.set('from', from);
      if (to) qs.set('to', to);

      const el = document.getElementById('filter-list');
      el.innerHTML = `<div class="loading">جاري التحميل...</div>`;

      let rows;
      try {
        const res = await get('/filters' + (qs.toString() ? '?' + qs.toString() : ''));
        rows = res.data;
      } catch (e) {
        el.innerHTML = `<div class="empty"><div class="empty-icon">❌</div><h3>تعذر تحميل السجلات</h3><p>${e.message}</p></div>`;
        toast(e.message, 'error');
        return;
      }

      const totalCost = rows.reduce((sum, r) => sum + (Number(r.cost) || 0), 0);
      document.getElementById('filter-summary').innerHTML = `
        <span>📄 <strong>${periodText(from, to)}</strong></span>
        <span>
          <strong>${rows.length}</strong> سجل
          ${totalCost ? ` — إجمالي التكلفة <span class="fs-cost">${fmtCost(totalCost)}</span>` : ''}
        </span>`;

      if (!rows.length) {
        const hasFilter = carId || type || from || to;
        el.innerHTML = `<div class="empty"><div class="empty-icon">🔧</div><h3>لا توجد سجلات</h3><p>${hasFilter ? 'مفيش تغييرات فلاتر مطابقة للفلاتر المختارة — جرّب توسيع الفترة أو «كل الفترات»' : 'سجل أول تغيير فلتر'}</p></div>`;
        return;
      }
      el.innerHTML = rows.map(r => {
        const lvl = kmLevel(r.km_remaining);
        const pct = Math.max(0, Math.min(100, (1 - r.km_remaining / r.next_change_km) * 100));
        const barColor = lvl === 'red' ? 'var(--red)' : lvl === 'orange' ? 'var(--orange)' : 'var(--green)';
        return `<div class="maint-card">
      <div class="maint-card-head">
        <div>
          <div class="maint-car">${r.plate}</div>
          <div class="maint-type">🔧 ${TYPE_LABELS[r.filter_type] || r.filter_type} — ${r.make} ${r.model}</div>
        </div>
        ${badge(r.km_remaining < 0 ? 'متأخر' : r.km_remaining < 2000 ? 'قريباً' : 'سليم', lvl)}
      </div>
      <div class="maint-row"><span>تاريخ التغيير</span><span>${fmtDate(r.change_date)}</span></div>
      <div class="maint-row"><span>عند الكيلومتر</span><span>${fmtKm(r.km_at_change)}</span></div>
      <div class="maint-row"><span>التغيير القادم</span><span>${fmtKm(r.next_filter_at_km)}</span></div>
      <div class="maint-row"><span>المتبقي</span><span style="color:${barColor}">${Number(r.km_remaining).toLocaleString()} كم</span></div>
      ${r.brand ? `<div class="maint-row"><span>الماركة</span><span>${r.brand}</span></div>` : ''}
      ${r.cost ? `<div class="maint-row"><span>التكلفة</span><span>${fmtCost(r.cost)}</span></div>` : ''}
      <div class="progress-bar"><div class="progress-fill" style="width:${pct}%;background:${barColor}"></div></div>
      <button class="btn btn-danger btn-sm" style="width:100%;margin-top:10px;justify-content:center" onclick="deleteFilter(${r.id})">🗑️ حذف</button>
    </div>`;
      }).join('');
    }

    function openModal() {
      document.getElementById('f-date').value = today();
      ['km', 'cost', 'brand', 'workshop', 'notes'].forEach(k => document.getElementById('f-' + k).value = '');
      document.getElementById('modal').classList.remove('hidden');
    }
    function closeModal() { document.getElementById('modal').classList.add('hidden'); }

    async function saveFilter() {
      const body = {
        car_id: document.getElementById('f-car').value,
        filter_type: document.getElementById('f-type').value,
        change_date: document.getElementById('f-date').value,
        km_at_change: Number(document.getElementById('f-km').value),
        next_change_km: Number(document.getElementById('f-next').value),
        brand: document.getElementById('f-brand').value || null,
        cost: document.getElementById('f-cost').value || null,
        workshop: document.getElementById('f-workshop').value || null,
        notes: document.getElementById('f-notes').value || null,
      };
      if (!body.car_id || !body.change_date || !body.km_at_change) return toast('يرجى ملء الحقول المطلوبة', 'error');
      try {
        await post('/filters', body);
        toast('تم تسجيل تغيير الفلتر ✅');
        closeModal(); loadFilters(); loadNavBadges();
      } catch (e) { toast(e.message, 'error'); }
    }

    async function deleteFilter(id) {
      if (!confirm('حذف هذا السجل؟')) return;
      try { await del(`/filters/${id}`); toast('تم الحذف'); loadFilters(); }
      catch (e) { toast(e.message, 'error'); }
    }

    document.getElementById('modal').addEventListener('click', e => { if (e.target === document.getElementById('modal')) closeModal(); });
    init().catch(e => toast(e.message, 'error'));
  </script>
</body>

</html>