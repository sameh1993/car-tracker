<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>قراءات العداد — كار تراك</title>
  <link rel="stylesheet" href="css/main.css" />
  <style>
    /* ===== Filters ===== */
    .filter-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      display: flex;
      gap: 12px;
      align-items: flex-end;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .filter-item {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .filter-item label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text2);
    }

    .filter-item select,
    .filter-item input {
      background: var(--bg3);
      border: 1px solid var(--border2);
      border-radius: var(--radius2);
      padding: 8px 12px;
      font-family: "Cairo", sans-serif;
      font-size: 13px;
      color: var(--text);
      outline: none;
      min-width: 160px;
    }

    .filter-item select:focus,
    .filter-item input:focus {
      border-color: var(--accent);
    }

    .filter-item.select-wide select {
      min-width: 260px;
    }

    .filter-actions {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    /* ===== Report summary ===== */
    .odo-period {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: var(--radius2);
      padding: 10px 14px;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--text2);
    }

    .odo-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .odo-stat {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius2);
      padding: 12px;
      text-align: center;
    }

    .odo-stat-val {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 2px;
    }

    .odo-stat-lbl {
      font-size: 11px;
      color: var(--text2);
    }

    /* ===== Report card ===== */
    .report-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 18px;
    }

    .report-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
    }

    .report-head h3 {
      font-size: 14px;
      font-weight: 700;
    }

    /* ===== Readings Table ===== */
    .odo-table-wrap {
      overflow-x: auto;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }

    .odo-table {
      width: 100%;
      min-width: 720px;
      border-collapse: collapse;
      font-size: 13px;
    }

    .odo-table thead tr {
      background: var(--bg3);
      border-bottom: 2px solid var(--border2);
    }

    .odo-table thead th {
      padding: 10px 14px;
      text-align: right;
      font-weight: 700;
      color: var(--text2);
      font-size: 12px;
      white-space: nowrap;
    }

    .odo-table tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.15s;
    }

    .odo-table tbody tr:last-child {
      border-bottom: none;
    }

    .odo-table tbody tr:hover {
      background: var(--bg3);
    }

    /* سيارة بدون قراءة في الفترة — تنبيه بخلفية حمراء خفيفة */
    .odo-table tbody tr.no-reading-row {
      background: rgba(239, 68, 68, 0.1);
    }

    .odo-table tbody tr.no-reading-row:hover {
      background: rgba(239, 68, 68, 0.17);
    }

    .odo-table tbody tr.no-reading-row .car-cell {
      color: var(--text);
    }

    .odo-table .td-noread {
      color: var(--red);
      font-weight: 700;
      font-size: 12px;
    }

    .no-read-badge {
      display: inline-block;
      background: rgba(239, 68, 68, 0.16);
      border: 1px solid rgba(239, 68, 68, 0.32);
      color: var(--red);
      border-radius: 20px;
      padding: 1px 8px;
      font-size: 10px;
      font-weight: 700;
    }

    .odo-table td {
      padding: 10px 14px;
      vertical-align: middle;
      white-space: nowrap;
    }

    .car-cell {
      font-weight: 700;
    }

    .car-sub {
      font-size: 10px;
      color: var(--text3);
      font-weight: 400;
    }

    .odo-table .td-prev {
      color: var(--text2);
      font-size: 12px;
    }

    .odo-table .td-curr {
      font-weight: 800;
      color: var(--accent);
    }

    .odo-table .td-diff {
      font-weight: 700;
    }

    .odo-table .td-diff.pos {
      color: var(--green);
    }

    .odo-table .td-diff.zero {
      color: var(--text3);
    }

    .odo-table .td-notes {
      font-size: 11px;
      color: var(--text2);
      max-width: 160px;
      white-space: normal;
    }

    .odo-table .td-action {
      text-align: center;
      width: 40px;
    }

    @media (max-width: 760px) {
      .odo-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .filter-card {
        padding: 12px;
      }

      .filter-item,
      .filter-item select,
      .filter-item input {
        flex: 1;
        min-width: 100%;
      }

      .filter-actions {
        width: 100%;
      }

      .filter-actions .btn {
        flex: 1;
        justify-content: center;
      }
    }

    @media (max-width: 560px) {

      /* hide prev on mobile */
      .odo-table thead th:nth-child(3),
      .odo-table td:nth-child(3) {
        display: none;
      }

      /* hide notes on mobile */
      .odo-table thead th:nth-child(6),
      .odo-table td:nth-child(6) {
        display: none;
      }

      .odo-table {
        min-width: 420px;
      }
    }

    @media print {

      .filter-card,
      .report-head .btn,
      .topbar .btn {
        display: none !important;
      }

      .report-card {
        border: none;
        padding: 0;
      }

      .odo-table-wrap {
        border: none;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <div id="sidebar-mount"></div>

    <div class="main">
      <div class="sm-menu">
        <div class="sidebar-logo">
          <div class="logo-icon">🚗</div>
          <div class="text">
            <h1>كار تراكر</h1>
            <p>نظام متابعة السيارات</p>
          </div>
        </div>
        <div class="bars">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="topbar">
        <div>
          <div class="page-title">🔢 قراءات العداد</div>
          <div class="page-sub">تقرير يومي لقراءات عداد كل السيارات المسجلة</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-primary" href="/odometer-capture">➕ إضافة قراءة</a>
          <button class="btn btn-ghost" onclick="window.print()">🖨️ طباعة</button>
        </div>
      </div>
      <div class="content">
        <!-- فلتر التقرير -->
        <div class="filter-card">
          <div class="filter-item select-wide">
            <label for="filter-car">السيارة</label>
            <select id="filter-car" onchange="onFilterCarChange()">
              <option value="">🚗 كل السيارات</option>
            </select>
          </div>

          <div class="filter-item">
            <label for="filter-from">من تاريخ</label>
            <input type="date" id="filter-from" onchange="loadReport()" />
          </div>

          <div class="filter-item">
            <label for="filter-to">إلى تاريخ</label>
            <input type="date" id="filter-to" onchange="loadReport()" />
          </div>

          <div class="filter-actions">
            <button class="btn btn-primary" onclick="loadReport()">📊 عرض التقرير</button>
            <button class="btn btn-ghost" onclick="setQuickRange('today')">اليوم</button>
            <button class="btn btn-ghost" onclick="setQuickRange('yesterday')">أمس</button>
            <button class="btn btn-ghost" onclick="setQuickRange('month')">هذا الشهر</button>
            <button class="btn btn-ghost" onclick="setQuickRange('all')">كل الفترات</button>
          </div>
        </div>

        <!-- ملخص التقرير -->
        <div id="report-summary"></div>

        <!-- جدول القراءات -->
        <div class="report-card">
          <div class="report-head">
            <h3>🔢 سجل قراءات العداد</h3>
            <span id="readings-count" style="font-size: 12px; color: var(--text2)"></span>
          </div>
          <div id="timeline">
            <div class="loading">جاري تحميل التقرير...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="js/jquery.min.js"></script>
  <script src="js/sidebar.js"></script>
  <script src="js/utils.js"></script>
  <script>
    renderSidebar();

    const SOURCE_LABELS = {
      manual: { label: "يدوي", cls: "blue" },
      oil_change: { label: "تغيير زيت", cls: "yellow" },
      filter_change: { label: "تغيير فلتر", cls: "blue" },
      license: { label: "رخصة", cls: "gray" },
      other: { label: "أخرى", cls: "gray" },
    };

    let _carsCache = null;

    const el = (id) => document.getElementById(id);

    // تاريخ محلي بصيغة YYYY-MM-DD (بدون مشاكل التوقيت)
    function isoLocal(d = new Date()) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${day}`;
    }

    // التقرير الافتراضي = تقرير اليوم
    el("filter-from").value = isoLocal();
    el("filter-to").value = isoLocal();

    // ── كاش السيارات ────────────────────────────────────────────
    async function getCars() {
      if (!_carsCache) {
        const { data } = await get("/cars");
        _carsCache = data;
      }
      return _carsCache;
    }

    const carLabel = (c) => `${c.plate} — ${c.make} ${c.model}`;

    async function loadCarList() {
      const cars = await getCars();
      const sel = el("filter-car");
      const prev = sel.value;
      sel.innerHTML =
        '<option value="">🚗 كل السيارات</option>' +
        cars
          .map(
            (c) =>
              `<option value="${c.id}">${carLabel(c)} (${fmtKm(c.current_km)})</option>`,
          )
          .join("");
      if (prev) sel.value = prev;
    }

    // ── تغيير السيارة (يأثر على التقرير) ────────────────────────
    function onFilterCarChange() {
      loadReport();
    }

    // ── وصف الفترة ──────────────────────────────────────────────
    function periodText(from, to) {
      if (from && to) {
        if (from === to) return `تقرير يوم ${fmtDate(from)}`;
        return `من ${fmtDate(from)} إلى ${fmtDate(to)}`;
      }
      if (from) return `من ${fmtDate(from)} حتى الآن`;
      if (to) return `حتى ${fmtDate(to)}`;
      return "كل الفترات";
    }

    // ── تحميل التقرير ───────────────────────────────────────────
    async function loadReport() {
      const carId = el("filter-car").value;
      const from = el("filter-from").value;
      const to = el("filter-to").value;

      if (from && to && from > to) {
        toast("تاريخ البداية لازم يكون قبل تاريخ النهاية", "error");
        return;
      }

      el("timeline").innerHTML =
        `<div class="loading">جاري تحميل التقرير...</div>`;
      el("report-summary").innerHTML = "";

      try {
        const qs = new URLSearchParams();
        if (carId) qs.set("car_id", carId);
        if (from) qs.set("from", from);
        if (to) qs.set("to", to);

        const [{ data: logs }, cars] = await Promise.all([
          get("/odometer" + (qs.toString() ? "?" + qs.toString() : "")),
          getCars(),
        ]);

        renderReport(logs, cars, { carId, from, to });
      } catch (e) {
        el("timeline").innerHTML = `<div class="empty"><div class="empty-icon">❌</div><h3>تعذر تحميل التقرير</h3><p>${e.message}</p></div>`;
        toast(e.message, "error");
      }
    }

    // ── رسم التقرير ─────────────────────────────────────────────
    function renderReport(logs, cars, { carId, from, to }) {
      const carsInReport = new Set(logs.map((l) => String(l.car_id)));
      const totalDistance = logs.reduce(
        (sum, l) =>
          sum + (Number(l.km_since_last) > 0 ? Number(l.km_since_last) : 0),
        0,
      );
      const selectedCar = carId ? cars.find((c) => String(c.id) === String(carId)) : null;

      // السيارات اللي ملهاش قراءة في الفترة (بتظهر في نفس الجدول بخلفية حمراء)
      const missingCars = carId
        ? selectedCar && !carsInReport.has(String(carId))
          ? [selectedCar]
          : []
        : cars.filter((c) => !carsInReport.has(String(c.id)));

      const registeredCount = carId ? 1 : cars.length;

      el("report-summary").innerHTML = `
        <div class="odo-period">
          <span>📄 ${periodText(from, to)} — ${selectedCar ? carLabel(selectedCar) : "كل السيارات"}</span>
          <span>${logs.length} قراءة${missingCars.length ? ` — ${missingCars.length} بدون قراءة` : ""}</span>
        </div>

        <div class="odo-stats">
          <div class="odo-stat">
            <div class="odo-stat-val" style="color:var(--accent)">${registeredCount}</div>
            <div class="odo-stat-lbl">${carId ? "السيارة المختارة" : "سيارات مسجلة"}</div>
          </div>
          <div class="odo-stat">
            <div class="odo-stat-val" style="color:var(--teal)">${carsInReport.size}</div>
            <div class="odo-stat-lbl">${carId ? "لها قراءة في الفترة" : "سيارات لها قراءة في الفترة"}</div>
          </div>
          <div class="odo-stat">
            <div class="odo-stat-val" style="color:var(--red)">${missingCars.length}</div>
            <div class="odo-stat-lbl">سيارات بدون قراءة</div>
          </div>
          <div class="odo-stat">
            <div class="odo-stat-val">${logs.length}</div>
            <div class="odo-stat-lbl">عدد القراءات</div>
          </div>
          <div class="odo-stat">
            <div class="odo-stat-val" style="color:var(--green)">${totalDistance.toLocaleString("ar-EG")}</div>
            <div class="odo-stat-lbl">إجمالي المسافة (كم)</div>
          </div>
        </div>
      `;

      el("readings-count").textContent =
        `${logs.length} قراءة` +
        (missingCars.length ? ` — ${missingCars.length} بدون قراءة` : "");

      const tl = el("timeline");
      if (!logs.length && !missingCars.length) {
        tl.innerHTML = `<div class="empty"><div class="empty-icon">📭</div><h3>لا توجد قراءات في هذه الفترة</h3><p>جرّب توسيع نطاق التاريخ أو اختيار «كل الفترات»</p></div>`;
        return;
      }

      // صفوف السيارات اللي ملهاش قراءة
      const missingRows = missingCars
        .map(
          (c) => `<tr class="no-reading-row">
            <td><span class="no-read-badge">⚠️ بدون قراءة</span></td>
            <td><span class="car-cell">${c.plate}</span><br><span class="car-sub">${c.make} ${c.model}</span></td>
            <td><span style="color:var(--text3)">—</span></td>
            <td class="td-noread">لا توجد قراءة</td>
            <td><span style="color:var(--text3)">—</span></td>
            <td class="td-notes">لم يتم تسجيل قراءة في هذه الفترة</td>
            <td class="td-action"><button class="row-btn" onclick="quickAddReading(${c.id})" title="تسجيل قراءة">➕</button></td>
          </tr>`,
        )
        .join("");

      const rows = logs
        .map((log) => {
          const src = SOURCE_LABELS[log.source] || SOURCE_LABELS.other;
          const curr = Number(log.reading_km);
          const rawDiff = Number(log.km_since_last);
          const diff = rawDiff !== 0 ? rawDiff : null;
          const prevKm = diff !== null ? curr - diff : null;

          const prevCell =
            prevKm !== null
              ? `<span class="td-prev">${prevKm.toLocaleString("ar-EG")} كم</span>`
              : `<span style="color:var(--text3)">—</span>`;

          const diffCell =
            diff !== null
              ? `<span class="td-diff ${diff > 0 ? "pos" : "zero"}"${diff < 0 ? ' style="color:var(--red)"' : ""}>${diff > 0 ? "+" : ""}${diff.toLocaleString("ar-EG")} كم</span>`
              : `<span style="color:var(--text3)">—</span>`;

          const delBtn =
            log.source === "manual"
              ? `<button class="row-btn del" onclick="deleteReading(${log.id})" title="حذف">🗑️</button>`
              : "";

          return `<tr>
            <td>${fmtDate(log.reading_date)}<br><span style="font-size:10px;color:var(--text3)">${badge(src.label, src.cls)}</span></td>
            <td><span class="car-cell">${log.plate}</span><br><span class="car-sub">${log.make} ${log.model}</span></td>
            <td>${prevCell}</td>
            <td class="td-curr">${curr.toLocaleString("ar-EG")} كم</td>
            <td>${diffCell}</td>
            <td class="td-notes">${log.notes || "—"}</td>
            <td class="td-action">${delBtn}</td>
          </tr>`;
        })
        .join("");

      tl.innerHTML = `
        <div class="odo-table-wrap">
          <table class="odo-table">
            <thead>
              <tr>
                <th>التاريخ / المصدر</th>
                <th>السيارة</th>
                <th>القراءة السابقة</th>
                <th>القراءة الحالية</th>
                <th>الفرق</th>
                <th>ملاحظات</th>
                <th></th>
              </tr>
            </thead>
            <tbody>${rows}${missingRows}</tbody>
          </table>
        </div>`;
    }

    // ── فترات سريعة ─────────────────────────────────────────────
    function setQuickRange(type) {
      const now = new Date();

      if (type === "today") {
        el("filter-from").value = isoLocal(now);
        el("filter-to").value = isoLocal(now);
      } else if (type === "yesterday") {
        now.setDate(now.getDate() - 1);
        el("filter-from").value = isoLocal(now);
        el("filter-to").value = isoLocal(now);
      } else if (type === "month") {
        el("filter-from").value = isoLocal(
          new Date(now.getFullYear(), now.getMonth(), 1),
        );
        el("filter-to").value = isoLocal(
          new Date(now.getFullYear(), now.getMonth() + 1, 0),
        );
      } else {
        el("filter-from").value = "";
        el("filter-to").value = "";
      }

      loadReport();
    }

    // ── تسجيل قراءة سريع لسيارة بدون قراءة ─────────────────────
    function quickAddReading(carId) {
      location.href = "/odometer-capture?car_id=" + carId;
    }

    // ── حذف قراءة ───────────────────────────────────────────────
    async function deleteReading(id) {
      if (!confirm("حذف هذه القراءة؟")) return;

      try {
        await del(`/odometer/${id}`);
        toast("تم الحذف");

        _carsCache = null;
        await loadCarList();

        await loadReport();
        loadNavBadges();
      } catch (e) {
        toast(e.message, "error");
      }
    }

    // ── بدء الصفحة ──────────────────────────────────────────────
    async function init() {
      await loadCarList();

      const urlCar = new URLSearchParams(location.search).get("car");

      if (urlCar) {
        // جاي من صفحة السيارات — اعرض كل تاريخ هذه السيارة
        el("filter-car").value = urlCar;
        el("filter-from").value = "";
        el("filter-to").value = "";
        await loadReport();
      } else {
        await loadReport();
      }
    }

    init().catch((e) => toast(e.message, "error"));
  </script>
</body>

</html>
